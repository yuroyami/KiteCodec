package = ffmpeg.libavformat
language = C
headers = libavformat/avformat.h libavformat/avio.h libavformat/version.h
headerFilter = libavformat/* libavcodec/* libavutil/*
linkerOpts.osx = -lavformat
linkerOpts.linux = -lavformat
linkerOpts.mingw = -lavformat

---

#include <stdint.h>
#include <libavformat/avformat.h>
#include <libavutil/error.h>

/* ── AVFormatContext lifecycle ─────────────────────────────────────────── */

/* Open + close that hide the double-pointer ceremony. Returns 0 on success or AVERROR. */
static inline int ffkmp_fmt_open_input(AVFormatContext **out, const char *path) {
    AVFormatContext *ctx = NULL;
    int rc = avformat_open_input(&ctx, path, NULL, NULL);
    if (rc < 0) { *out = NULL; return rc; }
    *out = ctx;
    return 0;
}
static inline void ffkmp_fmt_close_input(AVFormatContext **ctx) {
    if (ctx && *ctx) {
        AVFormatContext *p = *ctx;
        avformat_close_input(&p);
        *ctx = NULL;
    }
}
static inline int ffkmp_fmt_find_stream_info(AVFormatContext *ctx) {
    return avformat_find_stream_info(ctx, NULL);
}
static inline int ffkmp_fmt_seek_micros(AVFormatContext *ctx, int stream_index, int64_t micros) {
    if (!ctx) return AVERROR(EINVAL);
    /* AV_TIME_BASE is microseconds. */
    int64_t target = stream_index < 0 ? micros : av_rescale_q(micros, AV_TIME_BASE_Q, ctx->streams[stream_index]->time_base);
    return av_seek_frame(ctx, stream_index, target, AVSEEK_FLAG_BACKWARD);
}
static inline int ffkmp_fmt_read_frame(AVFormatContext *ctx, AVPacket *pkt) {
    return av_read_frame(ctx, pkt);
}

/* ── AVFormatContext accessors ─────────────────────────────────────────── */

static inline int64_t       ffkmp_fmt_duration(const AVFormatContext *ctx)  { return ctx ? ctx->duration : 0; }
static inline int64_t       ffkmp_fmt_bit_rate(const AVFormatContext *ctx)  { return ctx ? ctx->bit_rate : 0; }
static inline unsigned int  ffkmp_fmt_nb_streams(const AVFormatContext *ctx){ return ctx ? ctx->nb_streams : 0; }
static inline AVStream*     ffkmp_fmt_stream(AVFormatContext *ctx, unsigned i) {
    return (ctx && i < ctx->nb_streams) ? ctx->streams[i] : NULL;
}
static inline const char*   ffkmp_fmt_iformat_name(const AVFormatContext *ctx) {
    return (ctx && ctx->iformat) ? ctx->iformat->name : NULL;
}
static inline AVDictionary* ffkmp_fmt_metadata(AVFormatContext *ctx) { return ctx ? ctx->metadata : NULL; }

/* ── AVStream accessors ────────────────────────────────────────────────── */

static inline int                  ffkmp_stream_index(const AVStream *s)        { return s ? s->index : -1; }
static inline AVCodecParameters*   ffkmp_stream_codecpar(AVStream *s)           { return s ? s->codecpar : NULL; }
static inline int64_t              ffkmp_stream_duration(const AVStream *s)    { return s ? s->duration : 0; }
static inline int64_t              ffkmp_stream_start_time(const AVStream *s)  { return s ? s->start_time : 0; }
static inline int64_t              ffkmp_stream_nb_frames(const AVStream *s)   { return s ? s->nb_frames : 0; }
static inline AVDictionary*        ffkmp_stream_metadata(AVStream *s)          { return s ? s->metadata : NULL; }
static inline void ffkmp_stream_time_base(const AVStream *s, int *num, int *den) {
    if (!s || !num || !den) { if (num) *num = 0; if (den) *den = 1; return; }
    *num = s->time_base.num; *den = s->time_base.den ? s->time_base.den : 1;
}
static inline void ffkmp_stream_avg_frame_rate(const AVStream *s, int *num, int *den) {
    if (!s || !num || !den) { if (num) *num = 0; if (den) *den = 1; return; }
    *num = s->avg_frame_rate.num; *den = s->avg_frame_rate.den ? s->avg_frame_rate.den : 1;
}
static inline void ffkmp_stream_r_frame_rate(const AVStream *s, int *num, int *den) {
    if (!s || !num || !den) { if (num) *num = 0; if (den) *den = 1; return; }
    *num = s->r_frame_rate.num; *den = s->r_frame_rate.den ? s->r_frame_rate.den : 1;
}
static inline void ffkmp_stream_set_time_base(AVStream *s, int num, int den) {
    if (s) { s->time_base.num = num; s->time_base.den = den ? den : 1; }
}

/* ── Output / muxer side ───────────────────────────────────────────────── */

static inline int ffkmp_fmt_alloc_output(AVFormatContext **out, const char *path) {
    AVFormatContext *ctx = NULL;
    int rc = avformat_alloc_output_context2(&ctx, NULL, NULL, path);
    if (rc < 0 || !ctx) { *out = NULL; return rc < 0 ? rc : AVERROR_UNKNOWN; }
    *out = ctx;
    return 0;
}
static inline void ffkmp_fmt_free_output(AVFormatContext **ctx) {
    if (ctx && *ctx) {
        if (!((*ctx)->oformat && ((*ctx)->oformat->flags & AVFMT_NOFILE)) && (*ctx)->pb) {
            avio_closep(&(*ctx)->pb);
        }
        avformat_free_context(*ctx);
        *ctx = NULL;
    }
}
static inline AVStream* ffkmp_fmt_new_stream(AVFormatContext *ctx, const AVCodec *codec) {
    return ctx ? avformat_new_stream(ctx, codec) : NULL;
}
static inline int ffkmp_fmt_io_open(AVFormatContext *ctx, const char *path) {
    if (!ctx) return AVERROR(EINVAL);
    if (ctx->oformat && (ctx->oformat->flags & AVFMT_NOFILE)) return 0;
    return avio_open(&ctx->pb, path, AVIO_FLAG_WRITE);
}
static inline int ffkmp_fmt_write_header(AVFormatContext *ctx) {
    return ctx ? avformat_write_header(ctx, NULL) : AVERROR(EINVAL);
}
static inline int ffkmp_fmt_write_frame(AVFormatContext *ctx, AVPacket *pkt) {
    return av_interleaved_write_frame(ctx, pkt);
}
static inline int ffkmp_fmt_write_trailer(AVFormatContext *ctx) {
    return ctx ? av_write_trailer(ctx) : AVERROR(EINVAL);
}
static inline int ffkmp_oformat_global_header(const AVFormatContext *ctx) {
    if (!ctx || !ctx->oformat) return 0;
    return (ctx->oformat->flags & AVFMT_GLOBALHEADER) ? 1 : 0;
}
