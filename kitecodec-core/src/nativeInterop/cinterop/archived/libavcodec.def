package = ffmpeg.libavcodec
language = C
headers = libavcodec/avcodec.h libavcodec/codec.h libavcodec/codec_id.h libavcodec/codec_par.h libavcodec/packet.h libavcodec/bsf.h libavcodec/defs.h libavcodec/version.h
headerFilter = libavcodec/* libavutil/*
linkerOpts.osx = -lavcodec
linkerOpts.linux = -lavcodec
linkerOpts.mingw = -lavcodec

---

#include <stdint.h>
#include <libavcodec/avcodec.h>
#include <libavcodec/codec_par.h>
#include <libavcodec/packet.h>

/* ── AVPacket lifecycle ───────────────────────────────────────────────── */

static inline AVPacket* ffkmp_packet_alloc(void)        { return av_packet_alloc(); }
static inline void      ffkmp_packet_free(AVPacket *p)  { if (p) { AVPacket *q = p; av_packet_free(&q); } }
static inline void      ffkmp_packet_unref(AVPacket *p) { if (p) av_packet_unref(p); }
static inline int       ffkmp_packet_ref(AVPacket *dst, const AVPacket *src) { return av_packet_ref(dst, src); }

/* AVPacket field accessors. */
static inline int64_t  ffkmp_packet_pts(const AVPacket *p)          { return p ? p->pts : AV_NOPTS_VALUE; }
static inline int64_t  ffkmp_packet_dts(const AVPacket *p)          { return p ? p->dts : AV_NOPTS_VALUE; }
static inline int      ffkmp_packet_stream_index(const AVPacket *p) { return p ? p->stream_index : -1; }
static inline int      ffkmp_packet_flags(const AVPacket *p)        { return p ? p->flags : 0; }
static inline int      ffkmp_packet_size(const AVPacket *p)         { return p ? p->size : 0; }
static inline int64_t  ffkmp_packet_duration(const AVPacket *p)     { return p ? p->duration : 0; }
static inline int      ffkmp_packet_is_keyframe(const AVPacket *p)  { return (p && (p->flags & AV_PKT_FLAG_KEY)) ? 1 : 0; }
static inline void     ffkmp_packet_rescale_ts(AVPacket *p, int src_num, int src_den, int dst_num, int dst_den) {
    if (!p) return;
    AVRational s = { src_num, src_den };
    AVRational d = { dst_num, dst_den };
    av_packet_rescale_ts(p, s, d);
}
static inline void     ffkmp_packet_set_stream_index(AVPacket *p, int i) { if (p) p->stream_index = i; }

/* ── AVCodecParameters accessors ──────────────────────────────────────── */

static inline int     ffkmp_codecpar_codec_type(const AVCodecParameters *p) { return p ? (int)p->codec_type : -1; }
static inline int     ffkmp_codecpar_codec_id(const AVCodecParameters *p)   { return p ? (int)p->codec_id : 0; }
static inline int64_t ffkmp_codecpar_bit_rate(const AVCodecParameters *p)   { return p ? p->bit_rate : 0; }
static inline int     ffkmp_codecpar_width(const AVCodecParameters *p)      { return p ? p->width : 0; }
static inline int     ffkmp_codecpar_height(const AVCodecParameters *p)     { return p ? p->height : 0; }
static inline int     ffkmp_codecpar_format(const AVCodecParameters *p)     { return p ? p->format : -1; }
static inline int     ffkmp_codecpar_sample_rate(const AVCodecParameters *p){ return p ? p->sample_rate : 0; }
static inline int     ffkmp_codecpar_channels(const AVCodecParameters *p)   { return p ? p->ch_layout.nb_channels : 0; }
static inline int     ffkmp_codecpar_video_delay(const AVCodecParameters *p){ return p ? p->video_delay : 0; }
static inline void    ffkmp_codecpar_sample_aspect_ratio(const AVCodecParameters *p, int *num, int *den) {
    if (!p || !num || !den) return;
    *num = p->sample_aspect_ratio.num;
    *den = p->sample_aspect_ratio.den ? p->sample_aspect_ratio.den : 1;
}

/* Used by the encoder side to populate parameters from an opened context. */
static inline int ffkmp_codecpar_from_context(AVCodecParameters *par, const AVCodecContext *ctx) {
    return avcodec_parameters_from_context(par, ctx);
}

/* ── AVCodecContext convenience ───────────────────────────────────────── */

static inline AVCodecContext* ffkmp_codecctx_alloc(const AVCodec *c) { return avcodec_alloc_context3(c); }
static inline void            ffkmp_codecctx_free(AVCodecContext *c) { if (c) { AVCodecContext *q = c; avcodec_free_context(&q); } }
static inline int             ffkmp_codecctx_open(AVCodecContext *c, const AVCodec *codec) {
    return avcodec_open2(c, codec, NULL);
}
static inline int             ffkmp_codecctx_from_par(AVCodecContext *c, const AVCodecParameters *p) {
    return avcodec_parameters_to_context(c, p);
}

/* Encoder configuration, done before open. */
static inline void ffkmp_codecctx_set_video(AVCodecContext *c,
                                            int width, int height, int pix_fmt,
                                            int fr_num, int fr_den,
                                            int tb_num, int tb_den,
                                            int64_t bit_rate,
                                            int gop_size) {
    if (!c) return;
    c->width = width;
    c->height = height;
    c->pix_fmt = (enum AVPixelFormat)pix_fmt;
    c->framerate.num = fr_num; c->framerate.den = fr_den ? fr_den : 1;
    c->time_base.num = tb_num; c->time_base.den = tb_den ? tb_den : 1;
    c->bit_rate = bit_rate;
    c->gop_size = gop_size;
}

static inline void ffkmp_codecctx_set_audio(AVCodecContext *c,
                                            int sample_rate, int channels, int sample_fmt,
                                            int64_t bit_rate) {
    if (!c) return;
    c->sample_rate = sample_rate;
    av_channel_layout_uninit(&c->ch_layout);
    av_channel_layout_default(&c->ch_layout, channels);
    c->sample_fmt = (enum AVSampleFormat)sample_fmt;
    c->bit_rate = bit_rate;
    c->time_base.num = 1; c->time_base.den = sample_rate;
}

/* AVCodecContext field reads needed at encode time. */
static inline int  ffkmp_codecctx_frame_size(const AVCodecContext *c)   { return c ? c->frame_size : 0; }
static inline int  ffkmp_codecctx_sample_rate(const AVCodecContext *c)  { return c ? c->sample_rate : 0; }
static inline int  ffkmp_codecctx_channels(const AVCodecContext *c)     { return c ? c->ch_layout.nb_channels : 0; }
static inline int  ffkmp_codecctx_sample_fmt(const AVCodecContext *c)   { return c ? (int)c->sample_fmt : -1; }
static inline void ffkmp_codecctx_time_base(const AVCodecContext *c, int *num, int *den) {
    if (!c || !num || !den) return;
    *num = c->time_base.num;
    *den = c->time_base.den ? c->time_base.den : 1;
}
static inline void ffkmp_codecctx_set_global_header(AVCodecContext *c) {
    if (c) c->flags |= AV_CODEC_FLAG_GLOBAL_HEADER;
}

/* AVCodec descriptor name. */
static inline const char* ffkmp_codec_name(const AVCodec *c) { return c ? c->name : NULL; }
static inline int         ffkmp_codec_id(const AVCodec *c)   { return c ? (int)c->id : 0; }

static inline const AVCodec* ffkmp_find_decoder_by_id(int id) { return avcodec_find_decoder((enum AVCodecID)id); }
static inline const AVCodec* ffkmp_find_encoder_by_id(int id) { return avcodec_find_encoder((enum AVCodecID)id); }
