package = ffmpeg.libavfilter
language = C
headers = libavfilter/avfilter.h libavfilter/buffersrc.h libavfilter/buffersink.h libavfilter/version.h
headerFilter = libavfilter/* libavutil/* libavcodec/*
linkerOpts.osx = -lavfilter
linkerOpts.linux = -lavfilter
linkerOpts.mingw = -lavfilter

---

#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <libavfilter/avfilter.h>
#include <libavfilter/buffersrc.h>
#include <libavfilter/buffersink.h>
#include <libavutil/opt.h>
#include <libavutil/imgutils.h>

/**
 * Build a single-input video filter graph. Returns 0 on success; sets *out_src to the
 * buffersrc context (caller pushes frames in) and *out_sink to the buffersink context
 * (caller pulls frames out). The graph itself is owned by *out_graph.
 *
 * description follows the standard `scale=W:H,eq=brightness=…` syntax.
 */
static inline int ffkmp_graph_build_video(
    AVFilterGraph **out_graph,
    AVFilterContext **out_src,
    AVFilterContext **out_sink,
    const char *description,
    int width, int height, int pix_fmt,
    int tb_num, int tb_den,
    int fr_num, int fr_den,
    int sar_num, int sar_den
) {
    *out_graph = NULL; *out_src = NULL; *out_sink = NULL;

    AVFilterGraph *graph = avfilter_graph_alloc();
    if (!graph) return AVERROR(ENOMEM);

    const AVFilter *src = avfilter_get_by_name("buffer");
    const AVFilter *sink = avfilter_get_by_name("buffersink");
    if (!src || !sink) { avfilter_graph_free(&graph); return AVERROR_FILTER_NOT_FOUND; }

    char args[512];
    snprintf(args, sizeof(args),
        "video_size=%dx%d:pix_fmt=%d:time_base=%d/%d:pixel_aspect=%d/%d:frame_rate=%d/%d",
        width, height, pix_fmt, tb_num, tb_den ? tb_den : 1,
        sar_num ? sar_num : 1, sar_den ? sar_den : 1,
        fr_num ? fr_num : 30, fr_den ? fr_den : 1);

    AVFilterContext *src_ctx = NULL;
    int rc = avfilter_graph_create_filter(&src_ctx, src, "in", args, NULL, graph);
    if (rc < 0) { avfilter_graph_free(&graph); return rc; }

    AVFilterContext *sink_ctx = NULL;
    rc = avfilter_graph_create_filter(&sink_ctx, sink, "out", NULL, NULL, graph);
    if (rc < 0) { avfilter_graph_free(&graph); return rc; }

    /* Pin the output pixel format to keep behaviour predictable for downstream encoders. */
    enum AVPixelFormat pix_fmts[] = { (enum AVPixelFormat)pix_fmt, AV_PIX_FMT_NONE };
    rc = av_opt_set_int_list(sink_ctx, "pix_fmts", pix_fmts, AV_PIX_FMT_NONE, AV_OPT_SEARCH_CHILDREN);
    if (rc < 0) { avfilter_graph_free(&graph); return rc; }

    AVFilterInOut *outputs = avfilter_inout_alloc();
    AVFilterInOut *inputs  = avfilter_inout_alloc();
    if (!outputs || !inputs) { avfilter_inout_free(&outputs); avfilter_inout_free(&inputs); avfilter_graph_free(&graph); return AVERROR(ENOMEM); }
    outputs->name = av_strdup("in");  outputs->filter_ctx = src_ctx;  outputs->pad_idx = 0; outputs->next = NULL;
    inputs->name  = av_strdup("out"); inputs->filter_ctx  = sink_ctx; inputs->pad_idx  = 0; inputs->next  = NULL;

    rc = avfilter_graph_parse_ptr(graph, description, &inputs, &outputs, NULL);
    avfilter_inout_free(&outputs);
    avfilter_inout_free(&inputs);
    if (rc < 0) { avfilter_graph_free(&graph); return rc; }

    rc = avfilter_graph_config(graph, NULL);
    if (rc < 0) { avfilter_graph_free(&graph); return rc; }

    *out_graph = graph;
    *out_src   = src_ctx;
    *out_sink  = sink_ctx;
    return 0;
}

static inline void ffkmp_graph_free(AVFilterGraph **g) {
    if (g && *g) { avfilter_graph_free(g); }
}

static inline int ffkmp_graph_send(AVFilterContext *src, AVFrame *frame) {
    return av_buffersrc_add_frame_flags(src, frame, AV_BUFFERSRC_FLAG_KEEP_REF);
}

static inline int ffkmp_graph_receive(AVFilterContext *sink, AVFrame *frame) {
    return av_buffersink_get_frame(sink, frame);
}
