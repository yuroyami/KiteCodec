package = ffmpeg
language = C
# kitecodec_abi.h comes LAST, after kitecodec_helpers.h. Order matters for one reason: both headers
# define KC_API, kitecodec_abi.h guards its own definition with #ifndef, and listing it last means the
# helper header's unguarded definition is always the one that wins. It includes no FFmpeg header and
# names no FFmpeg type, so nothing it adds can pull a new libav type into the binding; what it adds is
# the identity gate of register item B1-02 and the six kc_ functions register item B1-22 moves behind it.
headers = libavutil/display.h libavformat/avformat.h libavformat/avio.h libavformat/version.h libavcodec/avcodec.h libavcodec/codec.h libavcodec/codec_id.h libavcodec/codec_par.h libavcodec/packet.h libavcodec/bsf.h libavcodec/defs.h libavcodec/version.h libavfilter/avfilter.h libavfilter/buffersrc.h libavfilter/buffersink.h libavfilter/version.h libavutil/avutil.h libavutil/error.h libavutil/dict.h libavutil/log.h libavutil/mem.h libavutil/opt.h libavutil/pixfmt.h libavutil/pixdesc.h libavutil/samplefmt.h libavutil/channel_layout.h libavutil/rational.h libavutil/frame.h libavutil/imgutils.h libavutil/buffer.h libavutil/hwcontext.h libavutil/version.h libswscale/swscale.h libswscale/version.h libswresample/swresample.h libswresample/version.h kitecodec_handles.h kitecodec_helpers.h kitecodec_abi.h
headerFilter = libavutil/display.h libavformat/* libavcodec/* libavfilter/* libavutil/* libswscale/* libswresample/* kitecodec_handles.h kitecodec_helpers.h kitecodec_abi.h
linkerOpts.osx = -lavformat -lavcodec -lavfilter -lavutil -lswscale -lswresample
# The three registered iOS targets never got these six flags: StaticLinkFlags.forTarget emits
# no libav flag, so this file is the only place they can come from (register item B1-12).
linkerOpts.ios = -lavformat -lavcodec -lavfilter -lavutil -lswscale -lswresample
linkerOpts.linux = -lavformat -lavcodec -lavfilter -lavutil -lswscale -lswresample
linkerOpts.mingw = -lavformat -lavcodec -lavfilter -lavutil -lswscale -lswresample
# MediaCodec wrapper pulls in AMediaCodec (mediandk) + JNI glue; zlib + log are NDK staples.
linkerOpts.android = -lavformat -lavcodec -lavfilter -lavutil -lswscale -lswresample -lmediandk -landroid -llog -lz
# The FFmpeg helper layer, which used to be 949 lines of `static inline` C in this file. It is
# now compiled per target by :kitecodec-core:compileKiteCodecCFor<Target> and embedded in this
# klib. There is deliberately no libraryPaths entry: a def-relative path resolves against the
# Gradle project directory rather than against this file, and the directory is one per konan
# target, so the search path arrives as a -libraryPath from kitecodec-core/build.gradle.kts.
staticLibraries = libkitecodec.a
