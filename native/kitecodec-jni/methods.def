// The single registration manifest of the KiteCodec JNI adapter (S1.c.1 step 4).
//
// Every non-comment record is:
//
//   CLASS | KOTLIN_NAME | JVM_DESCRIPTOR | C_FUNCTION | CATEGORY
//
// CLASS is the binary name of the Kotlin bridge class declaring the private external method.
// KOTLIN_NAME is that method's exact name. JVM_DESCRIPTOR is its exact JNI descriptor.
// C_FUNCTION is the kj_* implementation registered for it. CATEGORY names the kj_*.c unit the
// function lives in plus the handle/result convention it follows:
//
//   token(K)   returns a jlong handle of kind K, 0 meaning refused/none
//   int        returns a raw FFmpeg int (negative AVERROR travels to Kotlin uninterpreted)
//   long/bool/void/string/bytes  what they say
//
// kj_registration.c includes THIS file (through the KJ_METHOD X-macro) to build its
// JNINativeMethod tables, and the Kotlin bridge (Internals.jvm.kt) declares one external per row.
// There is deliberately no second list anywhere: change a row here and both sides follow or fail
// loudly (a corrupted descriptor fails library load, which the manifest-parser test pins).
//
// The two exception classes the adapter throws (kj_util.c) and the keep rule must name:
//   io.github.yuroyami.kitecodec.JniHandleException
//   io.github.yuroyami.kitecodec.JniNativeException
//
// Bridge class for every current row:
//   io/github/yuroyami/kitecodec/Internals
//
// Format for the X-macro consumer: KJ_METHOD(class, name, descriptor, cfunc)

// ── abi: identity, version, VM attach (kj_abi.c) ─ COMPLETE ─────────────────────────────────
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeAbiVersion",       "()I",                    kj_abi_version)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeInit",             "()I",                    kj_abi_init)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeAttachCurrentVm",  "()I",                    kj_abi_attach_current_vm)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeIdentityReport",   "()Ljava/lang/String;",   kj_abi_identity_report)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeConfiguration",    "()Ljava/lang/String;",   kj_abi_configuration)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeHasDecoder",       "(Ljava/lang/String;)Z",  kj_abi_has_decoder)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeHasEncoder",       "(Ljava/lang/String;)Z",  kj_abi_has_encoder)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeHasFilter",        "(Ljava/lang/String;)Z",  kj_abi_has_filter)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeErrorEagain",      "()I",                    kj_abi_error_eagain)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeErrorEof",         "()I",                    kj_abi_error_eof)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeStrerror",         "(I)Ljava/lang/String;",  kj_abi_strerror)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeMediaTypeVideo",   "()I",                    kj_abi_media_type_video)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeMediaTypeAudio",   "()I",                    kj_abi_media_type_audio)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeMediaTypeSubtitle","()I",                    kj_abi_media_type_subtitle)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeMediaTypeData",    "()I",                    kj_abi_media_type_data)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeMediaTypeAttachment","()I",                  kj_abi_media_type_attachment)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeLiveHandles",      "()J",                    kj_abi_live_handles)

// ── packet (kj_packet.c) ─ COMPLETE ─────────────────────────────────────────────────────────
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativePacketAlloc",      "()J",                    kj_packet_alloc)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativePacketFree",       "(J)V",                   kj_packet_free)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativePacketClone",      "(J)J",                   kj_packet_clone)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativePacketPts",        "(J)J",                   kj_packet_pts)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativePacketDts",        "(J)J",                   kj_packet_dts)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativePacketDuration",   "(J)J",                   kj_packet_duration)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativePacketStreamIndex","(J)I",                   kj_packet_stream_index)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativePacketSize",       "(J)I",                   kj_packet_size)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativePacketIsKeyframe", "(J)Z",                   kj_packet_is_keyframe)

// ── format: open, streams, read, seek, metadata (kj_format.c) ─ SOL FILLS, PATTERN IS kj_packet.c
// Rows are decided; implement each kj_format_* by the kj_packet.c pattern (resolve handles via
// kj_handle_get, call exactly one ffkmp_* helper, mint tokens with kj_handle_put).
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFmtOpenInput",     "(Ljava/lang/String;)J",  kj_fmt_open_input)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFmtCloseInput",    "(J)V",                   kj_fmt_close_input)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFmtFindStreamInfo","(J)I",                   kj_fmt_find_stream_info)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFmtNbStreams",     "(J)I",                   kj_fmt_nb_streams)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFmtStream",        "(JI)J",                  kj_fmt_stream)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFmtDurationMicros","(J)J",                   kj_fmt_duration_micros)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFmtReadFrame",     "(JJ)I",                  kj_fmt_read_frame)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFmtSeekMicros",    "(JIJ)I",                 kj_fmt_seek_micros)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFmtSetOpt",        "(JLjava/lang/String;Ljava/lang/String;)I", kj_fmt_set_opt)
// ... remaining format rows (metadata dict walk, stream fields via kj_stream_*, codecpar
// accessors) are enumerated by Internals.jvm.kt's TODO block and follow the same shapes.

// ── codec: decoder open/send/receive/flush (kj_codec.c) ─ SOL FILLS, SAME PATTERN ───────────
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFindDecoderById",  "(I)J",                   kj_find_decoder_by_id)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFindDecoderByName","(Ljava/lang/String;)J",  kj_find_decoder_by_name)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeCodecCtxAlloc",    "(J)J",                   kj_codecctx_alloc)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeCodecCtxFree",     "(J)V",                   kj_codecctx_free)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeCodecCtxFromPar",  "(JJ)I",                  kj_codecctx_from_par)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeCodecCtxOpen",     "(JJ)I",                  kj_codecctx_open)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeCodecCtxSetOpt",   "(JLjava/lang/String;Ljava/lang/String;)I", kj_codecctx_set_opt)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeCodecCtxSendPacket","(JJ)I",                 kj_codecctx_send_packet)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeCodecCtxReceiveFrame","(JJ)I",               kj_codecctx_receive_frame)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeCodecCtxFlush",    "(J)V",                   kj_codecctx_flush)

// ── frame (kj_frame.c) ─ SOL FILLS, SAME PATTERN ────────────────────────────────────────────
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFrameAlloc",       "()J",                    kj_frame_alloc)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFrameFree",        "(J)V",                   kj_frame_free)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFramePts",         "(J)J",                   kj_frame_pts)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFrameWidth",       "(J)I",                   kj_frame_width)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFrameHeight",      "(J)I",                   kj_frame_height)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFrameFormat",      "(J)I",                   kj_frame_format)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFrameIsKeyframe",  "(J)Z",                   kj_frame_is_keyframe)
KJ_METHOD("io/github/yuroyami/kitecodec/Internals", "nativeFrameCopyPlanes",  "(J)[B",                  kj_frame_copy_planes)
// ... remaining frame rows (audio fields, color info, clone, convert) follow the same shapes.

// ── filter, sink, remux, transcode (kj_filter.c and category growth) ─ SOL FILLS ────────────
// Decided in S1.c.2: every remaining public operation of the ten expects gets its row here,
// named native<Owner><Operation>, implemented in its category unit by the kj_packet.c pattern.
// The manifest is the contract: no external without a row, no row without an implementation.
